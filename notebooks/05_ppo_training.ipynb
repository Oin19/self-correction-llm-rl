  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "# 05 — Reinforcement Learning: PPO Training\n",
    "**Goal**: Train the SFT model using Proximal Policy Optimization (PPO) with execution-guided sandbox rewards and KL divergence penalties (KL $\\beta=0.02$, LR $1\\times 10^{-6}$). Produces `./checkpoints/ppo/final`.\n",
    "\n",
    "---"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Step 1: Environment & Path Resolution"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "!pip install -q \"trl<0.12.0\" peft transformers datasets bitsandbytes accelerate\n",
    "\n",
    "import os, sys, shutil, torch\n",
    "\n",
    "# 1. Update src from latest junior-A branch\n",
    "if os.path.exists('/kaggle/working') and not os.path.exists('/kaggle/working/src/training/ppo.py'):\n",
    "    !rm -rf /kaggle/working/src\n",
    "    !git clone -b junior-A https://github.com/Oin19/self-correction-llm-rl.git temp_repo\n",
    "    !cp -r temp_repo/src /kaggle/working/src\n",
    "    !rm -rf temp_repo\n",
    "    print(\"SUCCESS: Updated src from junior-A branch!\")\n",
    "\n",
    "# 2. Uninstall torchao to prevent PEFT version conflicts\n",
    "!pip uninstall -y torchao\n",
    "\n",
    "repo_root = os.path.abspath(os.getcwd())\n",
    "if os.path.isdir('/kaggle/working') and os.path.exists('/kaggle/working/src'):\n",
    "    repo_root = '/kaggle/working'\n",
    "if repo_root not in sys.path:\n",
    "    sys.path.insert(0, repo_root)\n",
    "\n",
    "# 3. Locate & Copy SFT adapter checkpoint\n",
    "SFT_CHECKPOINT = \"./checkpoints/sft/final\"\n",
    "if not os.path.exists(SFT_CHECKPOINT) and os.path.exists('/kaggle/input'):\n",
    "    for root, dirs, files in os.walk('/kaggle/input'):\n",
    "        if 'adapter_config.json' in files and 'sft' in root.lower():
    "            dest = '/kaggle/working/checkpoints/sft/final'\n",
    "            os.makedirs(dest, exist_ok=True)\n",
    "            for item in os.listdir(root):\n",
    "                s = os.path.join(root, item)\n",
    "                d = os.path.join(dest, item)\n",
    "                if os.path.isfile(s): shutil.copy2(s, d)\n",
    "                elif os.path.isdir(s): shutil.copytree(s, d, dirs_exist_ok=True)\n",
    "            SFT_CHECKPOINT = dest\n",
    "            break\n",
    "\n",
    "print(f\"Project path added: {repo_root}\")\n",
    "print(f\"Verified SFT Adapter Checkpoint: {SFT_CHECKPOINT}\")\n"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Step 2: Load APPS Dataset & Tokenizer"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "from datasets import load_dataset\n",
    "from transformers import AutoTokenizer\n",
    "from src.training.ppo import normalize_tests\n",
    "\n",
    "MODEL_NAME = \"deepseek-ai/deepseek-coder-1.3b-instruct\"\n",
    "tokenizer = AutoTokenizer.from_pretrained(MODEL_NAME, trust_remote_code=True)\n",
    "if tokenizer.pad_token is None:\n",
    "    tokenizer.pad_token = tokenizer.eos_token\n",
    "\n",
    "print(\"Loading APPS dataset for PPO training (train[:1000])...\")\n",
    "apps = load_dataset('codeparrot/apps', revision='refs/convert/parquet', split='train[:1000]')\n",
    "apps_clean = apps.filter(lambda x: len(normalize_tests(x)) > 0)\n",
    "print(f\"Prepared {len(apps_clean)} APPS problems for PPO rollout.\")\n"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Step 3: APPS Canonical Control Pre-Check Verification"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "import json\n",
    "from src.execution.executor import PythonSandbox\n",
    "from src.rewards.execution_reward import compute_partial_reward\n",
    "\n",
    "print(\"=== PRE-CHECK: APPS Canonical Control Verification ===\")\n",
    "sandbox = PythonSandbox(default_timeout=5.0, max_memory_mb=1024.0)\n",
    "sample0 = apps_clean[0]\n",
    "tests0 = normalize_tests(sample0)\n",
    "\n",
    "raw_sol = sample0.get(\"solutions\", \"\")\n",
    "canonical0 = \"\"\n",
    "if isinstance(raw_sol, str) and raw_sol:\n",
    "    try:\n",
    "        s = json.loads(raw_sol)\n",
    "        canonical0 = s[0] if isinstance(s, list) and s else raw_sol\n",
    "    except Exception:\n",
    "        canonical0 = raw_sol\n",
    "elif isinstance(raw_sol, list) and raw_sol:\n",
    "    canonical0 = raw_sol[0]\n",
    "\n",
    "if canonical0:\n",
    "    res0 = sandbox.run_tests(canonical0, tests0)\n",
    "    rew0 = compute_partial_reward(res0.to_dict())\n",
    "    print(f\"Canonical Sample 0 Pre-Check -> STATUS: {res0.status}, PASSED/TOTAL: {res0.passed_tests}/{res0.total_tests}, REWARD: {rew0:.3f}\")\n",
    "    assert res0.status == \"AC\", f\"Expected AC on canonical control, got {res0.status}\"\n"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Step 4: Run Full PPO Training Loop with Sandbox Rewards"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "import time, gc\n",
    "if 'src.training.ppo' in sys.modules:\n",
    "    del sys.modules['src.training.ppo']\n",
    "from src.training.ppo import run_ppo_training\n",
    "\n",
    "print(\"=== Starting Full PPO Reinforcement Learning Training Loop ===\")\n",
    "gc.collect()\n",
    "if torch.cuda.is_available():\n",
    "    torch.cuda.empty_cache()\n",
    "\n",
    "ppo_trainer = run_ppo_training(\n",
    "    sft_model_path=SFT_CHECKPOINT,\n",
    "    tokenizer=tokenizer,\n",
    "    dataset=apps_clean,\n",
    "    output_dir=\"./checkpoints/ppo\",\n",
    "    num_epochs=1,\n",
    "    learning_rate=1e-6,\n",
    "    batch_size=2,\n",
    "    mini_batch_size=1,\n",
    "    gradient_accumulation_steps=2,\n",
    "    init_kl_coef=0.02,\n",
    "    target_kl=6.0,\n",
    "    max_steps=50,\n",
    ")\n",
    "\n",
    "print(\"\\nPPO Training completed successfully!\")\n",
    "print(\"Saved final PPO adapter checkpoint to ./checkpoints/ppo/final\")\n"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Step 5: Checkpoint Verification & Reload Test"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "import os, torch\n",
    "from peft import PeftModel, PeftConfig\n",
    "from transformers import AutoModelForCausalLM, AutoConfig\n",
    "from src.models.generation import extract_code_block\n",
    "\n",
    "PPO_PATH = \"./checkpoints/ppo/final\"\n",
    "print(f\"=== 1. Inspecting PPO Checkpoint Files in {PPO_PATH} ===\")\n",
    "if os.path.exists(PPO_PATH):\n",
    "    for fname in sorted(os.listdir(PPO_PATH)):\n",
    "        fpath = os.path.join(PPO_PATH, fname)\n",
    "        if os.path.isfile(fpath):\n",
    "            size_mb = os.path.getsize(fpath) / (1024 * 1024)\n",
    "            print(f\"  - {fname}: {size_mb:.2f} MB\")\n",
    "\n",
    "    print(\"\\n=== 2. Verifying PPO Adapter Configuration ===\")\n",
    "    if os.path.exists(os.path.join(PPO_PATH, 'adapter_config.json')):\n",
    "        config = PeftConfig.from_pretrained(PPO_PATH)\n",
    "        print(f\"  - lora_alpha: {getattr(config, 'lora_alpha', 'N/A')}\")\n",
    "        print(f\"  - r: {getattr(config, 'r', 'N/A')}\")\n",
    "        print(f\"  - target_modules: {list(getattr(config, 'target_modules', []))}\")\n",
    "        print(f\"  - peft_type: {getattr(config, 'peft_type', 'N/A')}\")\n",
    "\n",
    "    print(\"\\n=== 3. Reloading Saved PPO Model into PeftModel ===\")\n",
    "    base_model = AutoModelForCausalLM.from_pretrained(\n",
    "        MODEL_NAME,\n",
    "        torch_dtype=torch.float16 if torch.cuda.is_available() else torch.float32,\n",
    "        device_map=\"auto\" if torch.cuda.is_available() else None,\n",
    "        trust_remote_code=True,\n",
    "    )\n",
    "    reloaded_ppo = PeftModel.from_pretrained(base_model, PPO_PATH)\n",
    "    reloaded_ppo.eval()\n",
    "    print(\"SUCCESS: Reloaded PPO model successfully into PeftModel!\")\n",
    "\n",
    "    print(\"\\n=== 4. Running APPS Inference Check (3 Examples) ===\")\n",
    "    sample_prompts = [\n",
    "        apps_clean[0]['question'],\n",
    "        apps_clean[1]['question'],\n",
    "        apps_clean[2]['question']\n",
    "    ]\n",
    "    for idx, p in enumerate(sample_prompts):\n",
    "        prompt_text = f\"### Problem:\\n{p[:300]}\\n\\n### Solution:\\n```python\\n\"\n",
    "        inputs = tokenizer(prompt_text, return_tensors=\"pt\").to(next(reloaded_ppo.parameters()).device)\n",
    "        with torch.no_grad():\n",
    "            out = reloaded_ppo.generate(**inputs, max_new_tokens=100, do_sample=False)\n",
    "        gen_text = tokenizer.decode(out[0], skip_special_tokens=True)\n",
    "        print(f\"\\n--- PPO Inference Sample {idx + 1} ---\")\n",
    "        print(gen_text[:250] + \"...\")\n",
    "\n",
    "    print(\"\\nCheckpoint verification completed successfully: checkpoint files, model configuration, model reload, and inference generation verified.\")\n",
    "else:\n",
    "    raise FileNotFoundError(f\"PPO checkpoint not found at {PPO_PATH}\")\n"
   ]
  }
